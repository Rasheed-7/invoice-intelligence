# The UUID of a users row. The seed user is system@local; replace with a real
# reviewer UUID for a demo.
#
# The MVP has no authentication, so this is the identity every browser hitting
# this build claims when resolving a review case. Fine for a single-operator
# demo; not appropriate for a shared deployment.
#
# Leave it unset to disable the resolve form entirely (it renders disabled with
# an explanatory message). Find a UUID with:
#   docker exec invoice_intelligence_postgres psql -U invoice -d invoice_intelligence \
#     -c "SELECT id, email FROM users;"
VITE_REVIEWER_ID=