# Backend environment variables. Copy to .env and adjust as needed.

ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database - must match docker-compose.yml
DATABASE_URL=postgresql+psycopg://invoice:invoice@127.0.0.1:5432/invoice_intelligence

# Document storage - local root directory for uploaded files (git-ignored)
STORAGE_ROOT=./var/storage

# Maximum accepted upload size, in bytes (default: 20 MB)
MAX_UPLOAD_BYTES=20971520

# Comma-separated list of accepted upload content types
ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg

# Comma-separated list of accepted upload file extensions
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# LLM provider: "mock" (deterministic fixture + regex), or future: "local", "commercial"
LLM_PROVIDER=mock

# Embedding provider: "hash" (deterministic, offline, zero-cost), or future: a real model
EMBEDDING_PROVIDER=hash